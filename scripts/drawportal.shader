blueportal
{
	sort portal
	surfaceparm nomarks
	surfaceparm nodlight

	{
		program portal
		map models/blueportal.tga
		blendFunc blend
	}
}

redportal
{
	sort portal
	surfaceparm nomarks
	surfaceparm nodlight

	{
		program portal
		map models/redportal.tga
		blendFunc blend
	}
}

nodraw
{
	surfaceparm nomarks
	surfaceparm nodlight
	surfaceparm nodraw
}
