entityDef item_battery
{
	"spawnclass"	"ncItem"
	"model"			"models/items/battery.mdl"
	"mins"			"-16 -16 0"
	"maxs"			"16 16 16"
	"snd_acquire"  "ItemBattery.Touch"
	"snd_respawn"	"Item.Materialize"
	"inv_armor"		"skill:battery"
	"requires"		"item_suit"
	"physics"	"1"
}

